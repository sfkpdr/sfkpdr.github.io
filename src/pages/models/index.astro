---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelCard from '../../components/ModelCard.astro';
import FilterPanel, { type FilterGroup } from '../../components/FilterPanel.astro';
import EmptyState from '../../components/EmptyState.astro';
import Search from '@lucide/astro/icons/search';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import X from '@lucide/astro/icons/x';
import Cpu from '@lucide/astro/icons/cpu';
import { getModels, getPrompts, taskCategories } from '../../lib/content';

const [models, prompts] = await Promise.all([getModels(), getPrompts()]);

const promptCount = new Map<string, number>();
for (const p of prompts) {
  promptCount.set(p.data.model, (promptCount.get(p.data.model) ?? 0) + 1);
}

const usedTasks = [...new Set(models.flatMap((m) => m.data.tasks))];
const taskOptions = taskCategories
  .filter((c) => usedTasks.includes(c.id))
  .map((c) => ({
    value: c.id,
    label: c.name,
    count: models.filter((m) => m.data.tasks.includes(c.id)).length,
  }));

const usedRuntimes = [...new Set(models.flatMap((m) => m.data.runtimes))];
const runtimeOptions = usedRuntimes
  .map((value) => ({
    value,
    label: value,
    count: models.filter((m) => m.data.runtimes.includes(value)).length,
  }))
  .sort((a, b) => b.count - a.count);

const usedLicenses = [...new Set(models.map((m) => m.data.license))];
const licenseOptions = usedLicenses
  .map((value) => ({
    value,
    label: value,
    count: models.filter((m) => m.data.license === value).length,
  }))
  .sort((a, b) => b.count - a.count);

const groups: FilterGroup[] = [
  { key: 'tasks', label: '任务类型', options: taskOptions, allLabel: '全部任务' },
  { key: 'runtimes', label: '运行方式', options: runtimeOptions, allLabel: '全部运行方式' },
  { key: 'license', label: '许可证', options: licenseOptions, allLabel: '全部许可证' },
];

const hasModels = models.length > 0;
---

<BaseLayout
  title="模型库"
  description="开源 AI 模型资料库：能力、显存需求、运行方式、许可证与官方来源，按任务、运行方式和许可证筛选。"
>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a> <span>/</span> <span>模型库</span>
      </nav>
      <h1>模型库</h1>
      <p>
        不只是名字目录：每个模型都记下能力边界、参数规模、显存要求、运行方式和许可证。
        许可证以官方仓库声明为准，本站结论只作提示。
      </p>
    </div>
  </section>

  <div class="container">
    <div
      class="library"
      data-library
      data-groups="tasks,runtimes,license"
      data-index="/search-index/models.json"
    >
      <FilterPanel groups={groups} variant="sidebar" />

      <div>
        <div class="mobile-filter-bar">
          <button class="btn btn--ghost btn--sm" type="button" data-drawer-open>
            <SlidersHorizontal size={15} stroke-width={1.8} /> 筛选
          </button>
        </div>

        <div class="library__head">
          <div class="search-field" style="flex:1;min-width:220px;max-width:420px">
            <Search size={17} stroke-width={1.8} />
            <input
              type="search"
              placeholder="搜索模型名称、开发者或能力…"
              data-filter-search
              aria-label="在模型库中搜索"
            />
          </div>
          <div class="row" style="gap:10px">
            <span class="library__count">共 <b data-count>{models.length}</b> 个</span>
            <label class="select-wrap">
              <select aria-label="排序方式" data-sort>
                <option value="">最近更新</option>
                <option value="title">按名称</option>
              </select>
              <ChevronDown size={15} stroke-width={1.8} />
            </label>
          </div>
        </div>

        <div class="filter-summary" data-summary></div>

        {
          hasModels ? (
            <div class="grid grid--wide" data-grid>
              {models.map((model) => (
                <ModelCard model={model} promptCount={promptCount.get(model.data.slug) ?? 0} />
              ))}
            </div>
          ) : (
            <EmptyState
              title="模型库还没有内容"
              text="在手机端后台新增一条模型资料，填好开发者、许可证与官方链接，保存后自动出现在这里。"
            >
              <a class="btn btn--primary btn--sm" href="/admin/">打开手机端后台</a>
            </EmptyState>
          )
        }

        <div data-no-result hidden>
          <EmptyState title="没有匹配的模型" text="换个关键词，或者清空筛选条件再看看。">
            <button class="btn btn--ghost btn--sm" type="button" data-reset>清除全部筛选</button>
          </EmptyState>
        </div>

        <div class="notice" style="margin-top:28px">
          <Cpu size={16} stroke-width={1.8} />
          <span>
            硬件需求一栏只写我实际跑过的环境（例如「RTX 4070 Ti 12GB，FP8 量化」）。
            没有实测记录的模型宁可留空，也不编造帧率与显存数字。
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="filter-drawer" data-drawer data-open="false">
    <div class="filter-drawer__scrim" data-drawer-close></div>
    <div class="filter-drawer__panel">
      <div class="filter-drawer__head">
        <strong style="font-size:1rem">筛选条件</strong>
        <button class="icon-btn" type="button" data-drawer-close aria-label="关闭筛选">
          <X size={17} stroke-width={1.8} />
        </button>
      </div>
      <FilterPanel groups={groups} variant="drawer" />
      <button class="btn btn--primary btn--block" type="button" data-drawer-close style="margin-top:16px">
        查看结果
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/library-filter';
</script>
