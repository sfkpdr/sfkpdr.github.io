---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';
import FilterPanel, { type FilterGroup } from '../../components/FilterPanel.astro';
import EmptyState from '../../components/EmptyState.astro';
import Search from '@lucide/astro/icons/search';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import X from '@lucide/astro/icons/x';
import { getPrompts, getModels, taskCategories } from '../../lib/content';

const [prompts, models] = await Promise.all([getPrompts(), getModels()]);
const modelIndex = new Map(models.map((m) => [m.data.slug, m]));

// —— 由内容自动生成筛选项，新增内容不需要改页面 ——
const usedModelSlugs = [...new Set(prompts.map((p) => p.data.model))];
const modelOptions = usedModelSlugs
  .map((slug) => ({
    value: slug,
    label: modelIndex.get(slug)?.data.name ?? slug,
    count: prompts.filter((p) => p.data.model === slug).length,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'zh-Hans-CN'));

const usedCategories = [...new Set(prompts.map((p) => p.data.category))];
const categoryOptions = taskCategories
  .filter((c) => usedCategories.includes(c.id))
  .map((c) => ({
    value: c.id,
    label: c.name,
    count: prompts.filter((p) => p.data.category === c.id).length,
  }));

const tagCounts = new Map<string, number>();
for (const prompt of prompts) {
  for (const tag of prompt.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tagOptions = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN'))
  .slice(0, 30)
  .map(([value, count]) => ({ value, label: value, count }));

const groups: FilterGroup[] = [
  { key: 'model', label: '适用模型', options: modelOptions, allLabel: '全部模型' },
  { key: 'category', label: '任务分类', options: categoryOptions, allLabel: '全部任务' },
  {
    key: 'tested',
    label: '实测状态',
    options: [
      { value: '1', label: '已实测', count: prompts.filter((p) => p.data.tested).length },
      { value: '0', label: '未实测', count: prompts.filter((p) => !p.data.tested).length },
    ],
    allLabel: '不限',
  },
  { key: 'tag', label: '标签', options: tagOptions, allLabel: '全部标签', field: 'tags' },
];

const hasPrompts = prompts.length > 0;
---

<BaseLayout
  title="提示词库"
  description="按模型、任务和标签筛选的 AI 提示词库：每条提示词都配着它自己生成的那张效果图，可一键复制。"
>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a> <span>/</span> <span>提示词库</span>
      </nav>
      <h1>提示词库</h1>
      <p>
        一条提示词 = 一张对应效果图 + 一份完整提示词 + 适用模型。按模型、任务、标签筛选，
        或者直接搜索提示词正文。
      </p>
    </div>
  </section>

  <div class="container">
    <div
      class="library"
      data-library
      data-groups="model,category,tested,tag"
      data-index="/search-index/prompts.json"
    >
      <FilterPanel groups={groups} variant="sidebar" />

      <div>
        <div class="mobile-filter-bar">
          <button class="btn btn--ghost btn--sm" type="button" data-drawer-open>
            <SlidersHorizontal size={15} stroke-width={1.8} /> 筛选
          </button>
        </div>

        <div class="library__head">
          <div class="search-field" style="flex:1;min-width:220px;max-width:420px">
            <Search size={17} stroke-width={1.8} />
            <input
              type="search"
              placeholder="搜索标题、关键词或提示词正文…"
              data-filter-search
              aria-label="在提示词库中搜索"
            />
          </div>
          <div class="row" style="gap:10px">
            <span class="library__count">共 <b data-count>{prompts.length}</b> 条</span>
            <label class="select-wrap">
              <select aria-label="排序方式" data-sort>
                <option value="">最近更新</option>
                <option value="oldest">最早更新</option>
                <option value="title">按标题</option>
              </select>
              <ChevronDown size={15} stroke-width={1.8} />
            </label>
          </div>
        </div>

        <div class="filter-summary" data-summary></div>

        {
          hasPrompts ? (
            <div class="grid grid--cards" data-grid>
              {prompts.map((prompt, index) => (
                <PromptCard prompt={prompt} model={modelIndex.get(prompt.data.model)} eager={index < 3} />
              ))}
            </div>
          ) : (
            <EmptyState
              title="提示词库还是空的"
              text="在手机端打开管理后台，点「新增提示词」，上传效果图并粘贴提示词，保存后这里会自动出现。"
            >
              <a class="btn btn--primary btn--sm" href="/admin/">打开手机端后台</a>
            </EmptyState>
          )
        }

        <div data-no-result hidden>
          <EmptyState title="没有匹配的提示词" text="换个关键词，或者点击下面的按钮清空筛选条件。">
            <button class="btn btn--ghost btn--sm" type="button" data-reset>清除全部筛选</button>
          </EmptyState>
        </div>
      </div>
    </div>
  </div>

  <!-- 手机端筛选抽屉 -->
  <div class="filter-drawer" data-drawer data-open="false">
    <div class="filter-drawer__scrim" data-drawer-close></div>
    <div class="filter-drawer__panel">
      <div class="filter-drawer__head">
        <strong style="font-size:1rem">筛选条件</strong>
        <button class="icon-btn" type="button" data-drawer-close aria-label="关闭筛选">
          <X size={17} stroke-width={1.8} />
        </button>
      </div>
      <FilterPanel groups={groups} variant="drawer" />
      <button class="btn btn--primary btn--block" type="button" data-drawer-close style="margin-top:16px">
        查看结果
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/library-filter';
</script>
