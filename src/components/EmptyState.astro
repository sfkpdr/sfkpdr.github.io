---
import Feather from '@lucide/astro/icons/feather';

interface Props {
  title: string;
  text?: string;
  hint?: string;
  icon?: 'feather';
}

const { title, text = '', hint = '' } = Astro.props;
---

<div class="empty">
  <div class="empty__icon"><Feather size={22} stroke-width={1.7} /></div>
  <h3>{title}</h3>
  {text && <p>{text}</p>}
  {hint && <p class="small" style="color:var(--ink-faint)">{hint}</p>}
  <slot />
</div>
